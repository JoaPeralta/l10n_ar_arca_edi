<?xml version="1.0" encoding="utf-8"?>
<!--
    Initial configuration, not enforced configuration.

    Whether a cron is running is an operational decision, taken per database
    and often deliberately against the default: the homologación database has
    both fiscal crons switched off while the first vouchers are authorized by
    hand.

    Loaded as ordinary records, these defaults were re-applied on every
    `odoo -u l10n_ar_arca_edi`. Upgrading to pick up an unrelated fix switched
    `Reconcile Unresolved Authorizations` back on, and that cron contacts ARCA.
    An upgrade must never be a way to start talking to a fiscal authority.

    `noupdate="1"` makes these values what a fresh install starts from and
    nothing else. Odoo's loader skips a record whose noupdate is set whenever
    the mode is not `init`, so the switches an administrator set are left
    alone. The attribute is read from this file on every load, so it protects
    the first upgrade too, not only the ones after it.

    What this also means, and it is the price: `interval_number`, `code` and
    `name` stop reaching databases that already have these records. A future
    change to what a cron *runs* needs a migration script to carry it, because
    this file will no longer deliver it on its own.
-->
<odoo noupdate="1">

    <record id="ir_cron_check_arca_certificate_expiration" model="ir.cron">
        <field name="name">ARCA: Check Certificate Expiration</field>
        <field name="model_id" ref="model_l10n_ar_arca_certificate"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_certificate_expiration()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!--
        Closes attempts whose answer never arrived. Without it an invoice could
        sit in an unknown fiscal state until somebody noticed, which is exactly
        the situation that leads to issuing the same voucher twice.
    -->
    <record id="ir_cron_reconcile_arca_attempts" model="ir.cron">
        <field name="name">ARCA: Reconcile Unresolved Authorizations</field>
        <field name="model_id" ref="model_l10n_ar_arca_attempt"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_open_attempts()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!--
        Picks up invoices that were posted but never authorized, for instance
        because ARCA was unreachable at the time. Inactive by default so that
        authorizing invoices unattended stays an explicit decision.
    -->
    <record id="ir_cron_authorize_pending_invoices" model="ir.cron">
        <field name="name">ARCA: Authorize Pending Invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_ar_arca_authorize_pending()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
